{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "module": "node20",
    "target": "ES2021",
    "resolveJsonModule": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./lib"
  },
  "include": ["./src/**/*.ts", "./src/**/*.js"]
}
