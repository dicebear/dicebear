{
  "name": "root",
  "private": true,
  "packageManager": "npm@11.21.1",
  "workspaces": {
    "packages": [
      "packages/dicebear",
      "packages/@dicebear/*",
      "apps/*"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:scripts": "node --test 'tests/**/*.test.js'",
    "prepare-publish": "node scripts/version.mjs",
    "prettier": "prettier --write \"{packages,apps}/**/*.{js,ts,json,md}\""
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "minimatch": ">=10.2.1",
    "serialize-javascript": "7.0.3"
  }
}
