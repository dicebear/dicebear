{
  "name": "root",
  "private": true,
  "packageManager": "npm@11.21.1",
  "workspaces": {
    "packages": [
      "src/js/*",
      "apps/*"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "test:scripts": "node --test 'tests/**/*.test.js'",
    "fixtures:parity": "node tests/fixtures/parity/generate.mjs",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "prettier": "prettier --write \"{src,apps}/**/*.{js,ts,vue,json,md}\" \"*.md\"",
    "prettier:check": "prettier --check \"{src,apps}/**/*.{js,ts,vue,json,md}\" \"*.md\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": ">=10.2.1",
    "serialize-javascript": "7.0.3",
    "esbuild": "^0.28.1"
  }
}
