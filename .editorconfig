[*]
charset = utf-8
indent_style = space
indent_size = 2
tab_width = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# The .NET convention, and what `dotnet format` enforces. The other ports whose
# formatters disagree with the two-space default (rustfmt, gofmt, ruff) bring
# their own config; C# reads this file, so the exception is spelled out here.
[*.cs]
indent_size = 4
tab_width = 4

[*.yml]
indent_size = 2
tab_width = 2

[.dist-tag]
insert_final_newline = false
